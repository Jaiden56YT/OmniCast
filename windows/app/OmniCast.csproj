<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>OmniCast</RootNamespace>
    <AssemblyName>OmniCast</AssemblyName>
    <Version>0.2.2</Version>
    <Product>OmniCast for Windows</Product>
    <Copyright>GPL-2.0-or-later</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\OmniCast.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- WinUI 3, unpackaged and self-contained: the folder runs on any
         Windows 10 (2004+) / 11 PC without installing .NET or the Windows App
         SDK runtime. -->
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Program.cs has Main (single instance, benchmark mode). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- Startup speed on low-end PCs: ReadyToRun precompiles the app. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Smaller download: drop the parts of .NET and the Windows API
         projection the app never calls (settings JSON is source-generated). -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <TieredPGO>true</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the Windows App SDK parts OmniCast uses (not the AI / ML ones the
         Microsoft.WindowsAppSDK metapackage would bundle): WinUI, app
         lifecycle and notifications, windowing. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260803003" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="1.8.260803002" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="1.8.260708001" />
    <!-- Direct2D drawing for the overlays (chat, now playing, the Discord call). -->
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Discord call overlay talks to Discord over a named pipe; keep the
         pipes library (trimming otherwise leaves it out of the app's load list). -->
    <TrimmerRootAssembly Include="System.IO.Pipes" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
