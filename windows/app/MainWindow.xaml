<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OmniCast.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="OmniCast">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Windows 11 title bar: icon, name, live/recording state. Caption
             buttons and snap layouts come from Windows. -->
        <Grid x:Name="AppTitleBar" Height="48" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/OmniCast.png" Width="16" Height="16" Margin="16,0,0,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="OmniCast" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Border x:Name="LivePill" Visibility="Collapsed" Background="{StaticResource LiveBrush}" CornerRadius="4" Padding="6,1">
                    <TextBlock Text="LIVE" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                </Border>
                <Border x:Name="RecPill" Visibility="Collapsed" BorderBrush="{StaticResource LiveBrush}" BorderThickness="1" CornerRadius="4" Padding="6,0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource LiveBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="REC" FontSize="11" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="LeftCompact"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            IsPaneToggleButtonVisible="True"
            OpenPaneLength="220"
            SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Studio" Tag="studio" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE714;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Destinations" Tag="destinations">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
