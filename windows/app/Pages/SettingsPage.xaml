<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OmniCast.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <!-- A row in the Windows 11 Settings style: title and description on
             the left, the control on the right. -->
        <Style x:Key="RowStyle" TargetType="Grid">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="ColumnSpacing" Value="16" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}" />
        <Style x:Key="RowDescription" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="24,4,24,32" Spacing="4" MaxWidth="1000" HorizontalAlignment="Stretch">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8" />

            <!-- Video -->
            <TextBlock Text="Video" Style="{StaticResource SectionHeaderStyle}" Margin="0,8,0,8" />
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Resolution" Style="{StaticResource RowTitle}" />
                    <TextBlock x:Name="ResolutionHint" Style="{StaticResource RowDescription}" />
                </StackPanel>
                <ComboBox x:Name="ResolutionBox" Grid.Column="1" VerticalAlignment="Center" MinWidth="200" SelectionChanged="Video_Changed">
                    <x:String>720p (1280×720)</x:String>
                    <x:String>1080p (1920×1080)</x:String>
                </ComboBox>
            </Grid>
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Frame rate" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="Both canvases run at the same rate." Style="{StaticResource RowDescription}" />
                </StackPanel>
                <ComboBox x:Name="FpsBox" Grid.Column="1" VerticalAlignment="Center" MinWidth="200" SelectionChanged="Video_Changed">
                    <x:String>60 fps</x:String>
                    <x:String>30 fps</x:String>
                </ComboBox>
            </Grid>
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Stream bitrate" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="Kbps per canvas. Twitch allows up to 6000; YouTube takes more. Keep the total under about 75% of your upload speed." Style="{StaticResource RowDescription}" />
                </StackPanel>
                <NumberBox x:Name="WideKbps" Grid.Column="1" Header="16:9" Minimum="500" Maximum="51000" SmallChange="500" LargeChange="1000"
                           SpinButtonPlacementMode="Compact" Width="120" ValueChanged="Video_Changed" />
                <NumberBox x:Name="TallKbps" Grid.Column="2" Header="9:16" Minimum="500" Maximum="51000" SmallChange="500" LargeChange="1000"
                           SpinButtonPlacementMode="Compact" Width="120" ValueChanged="Video_Changed" />
            </Grid>
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Encoder" Style="{StaticResource RowTitle}" />
                    <TextBlock x:Name="EncoderText" Style="{StaticResource RowDescription}" />
                </StackPanel>
                <Button x:Name="ApplyVideo" Grid.Column="1" Content="Apply video changes" Style="{StaticResource AccentButtonStyle}"
                        VerticalAlignment="Center" IsEnabled="False" Click="ApplyVideo_Click" />
            </Grid>
            <InfoBar x:Name="VideoError" Severity="Error" IsClosable="True" />

            <!-- Recording -->
            <TextBlock Text="Recording" Style="{StaticResource SectionHeaderStyle}" />
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Folder" Style="{StaticResource RowTitle}" />
                    <TextBlock x:Name="FolderText" Style="{StaticResource RowDescription}" IsTextSelectionEnabled="True" />
                </StackPanel>
                <Button Grid.Column="1" Content="Open" VerticalAlignment="Center" Click="OpenFolder_Click" />
                <Button Grid.Column="2" Content="Change…" VerticalAlignment="Center" Click="ChangeFolder_Click" />
            </Grid>
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="What to record" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="Each canvas is its own MP4. Files stay playable even if the PC crashes mid-recording." Style="{StaticResource RowDescription}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <CheckBox x:Name="RecWide" Content="16:9" Click="Recording_Changed" MinWidth="0" />
                    <CheckBox x:Name="RecTall" Content="9:16" Click="Recording_Changed" MinWidth="0" />
                </StackPanel>
            </Grid>
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Separate audio tracks" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="Track 1 is the full mix; track 2 is desktop audio only; track 3 is the mic only." Style="{StaticResource RowDescription}" />
                </StackPanel>
                <ToggleSwitch x:Name="SplitAudio" Grid.Column="1" Toggled="Recording_Changed" OnContent="On" OffContent="Off" MinWidth="0" />
            </Grid>
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Recording quality" Style="{StaticResource RowTitle}" />
                    <TextBlock x:Name="QualityHint" Style="{StaticResource RowDescription}" />
                </StackPanel>
                <Slider x:Name="QualitySlider" Grid.Column="1" Width="200" Minimum="14" Maximum="30" StepFrequency="1"
                        IsDirectionReversed="True" VerticalAlignment="Center" ValueChanged="Recording_Changed"
                        AutomationProperties.Name="Recording quality (lower is better)" />
            </Grid>

            <!-- Audio -->
            <TextBlock Text="Audio" Style="{StaticResource SectionHeaderStyle}" />
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Mic" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                <ComboBox x:Name="MicBox" Grid.Column="1" MinWidth="280" DisplayMemberPath="Name" SelectionChanged="Audio_Changed" />
            </Grid>
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Desktop audio" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="Everything this output device plays goes on stream." Style="{StaticResource RowDescription}" />
                </StackPanel>
                <ComboBox x:Name="DesktopBox" Grid.Column="1" MinWidth="280" DisplayMemberPath="Name" SelectionChanged="Audio_Changed" />
            </Grid>

            <!-- Discord -->
            <TextBlock Text="Discord" Style="{StaticResource SectionHeaderStyle}" />
            <!-- Shown until a virtual cable is installed: how to get VB-CABLE. -->
            <InfoBar x:Name="CableMissing" Severity="Informational" IsClosable="False" IsOpen="False"
                     Title="Discord audio needs VB-CABLE"
                     Message="VB-CABLE is a free virtual audio cable from VB-Audio. On their page, download the VB-CABLE Driver Pack, unzip it, right-click VBCABLE_Setup_x64.exe › Run as administrator › Install Driver, then restart your PC. OmniCast finds it on its own.">
                <InfoBar.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                        <Button Content="Get VB-CABLE" Style="{StaticResource AccentButtonStyle}" Click="GetCable_Click" />
                        <Button Content="Check again" Click="CheckCable_Click" />
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Voice: your mic into Discord" Style="{StaticResource RowTitle}" />
                    <TextBlock Style="{StaticResource RowDescription}"
                               Text="Discord hears your mic through OmniCast, with its level, mute and scene mute. In Discord: Settings › Voice &amp; Video › Input Device › CABLE Output." />
                    <TextBlock x:Name="VoiceStatus" Style="{StaticResource RowDescription}" />
                </StackPanel>
                <ComboBox x:Name="VoiceBox" Grid.Column="1" MinWidth="240" VerticalAlignment="Center" DisplayMemberPath="Name"
                          SelectionChanged="Discord_Changed" AutomationProperties.Name="Discord voice output" />
            </Grid>
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Stream audio without your mic" Style="{StaticResource RowTitle}" />
                    <TextBlock Style="{StaticResource RowDescription}"
                               Text="Desktop audio and the capture card, for an app that takes a microphone (e.g. a second Discord account in a watch-party channel). Discord's own Go Live doesn't need it: on Windows it takes sound from the window you share. Needs its own cable (VB-CABLE A+B or Voicemeeter)." />
                    <TextBlock x:Name="StreamAudioStatus" Style="{StaticResource RowDescription}" />
                </StackPanel>
                <ComboBox x:Name="StreamAudioBox" Grid.Column="1" MinWidth="240" VerticalAlignment="Center" DisplayMemberPath="Name"
                          SelectionChanged="Discord_Changed" AutomationProperties.Name="Stream audio output" />
            </Grid>

            <!-- Chat -->
            <TextBlock Text="Chat" Style="{StaticResource SectionHeaderStyle}" />
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="YouTube handle" Style="{StaticResource RowTitle}" />
                    <TextBlock x:Name="YouTubeStatus" Style="{StaticResource RowDescription}" Text="Off" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBox x:Name="YouTubeName" Width="200" PlaceholderText="yourhandle" AutomationProperties.Name="YouTube handle" />
                    <ToggleSwitch x:Name="YouTubeOn" OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="Read YouTube handle" />
                </StackPanel>
            </Grid>
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Twitch channel" Style="{StaticResource RowTitle}" />
                    <TextBlock x:Name="TwitchStatus" Style="{StaticResource RowDescription}" Text="Off" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBox x:Name="TwitchName" Width="200" PlaceholderText="yourchannel" AutomationProperties.Name="Twitch channel" />
                    <ToggleSwitch x:Name="TwitchOn" OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="Read Twitch channel" />
                </StackPanel>
            </Grid>
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Kick channel" Style="{StaticResource RowTitle}" />
                    <TextBlock x:Name="KickStatus" Style="{StaticResource RowDescription}" Text="Off" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBox x:Name="KickName" Width="200" PlaceholderText="yourchannel" AutomationProperties.Name="Kick channel" />
                    <ToggleSwitch x:Name="KickOn" OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="Read Kick channel" />
                </StackPanel>
            </Grid>
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Read only" Style="{StaticResource RowTitle}" />
                    <TextBlock x:Name="ChatSummary" Style="{StaticResource RowDescription}" Text="Chat is read only: nothing is ever posted. YouTube connects once you go live. Instagram doesn't let apps read live chat." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Add test messages" Click="ChatTest_Click" />
                    <Button Content="Clear" Click="ChatClear_Click" />
                    <Button Content="Save and reconnect" Style="{StaticResource AccentButtonStyle}" Click="ChatSave_Click" />
                </StackPanel>
            </Grid>
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Show chat" Style="{StaticResource RowTitle}" />
                    <TextBlock  Style="{StaticResource RowDescription}" Text="The merged chat on the 16:9 canvas." />
                </StackPanel>
                <ToggleSwitch x:Name="ChatVisible" Grid.Column="1" Toggled="ChatLook_Changed" AutomationProperties.Name="Show chat" />
            </Grid>
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Also on 9:16" Style="{StaticResource RowTitle}" />
                    <TextBlock  Style="{StaticResource RowDescription}" Text="Puts the chat on the vertical canvas too." />
                </StackPanel>
                <ToggleSwitch x:Name="ChatVertical" Grid.Column="1" Toggled="ChatLook_Changed" AutomationProperties.Name="Show chat on 9:16" />
            </Grid>
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Text size" Style="{StaticResource RowTitle}" />
                    <TextBlock  Style="{StaticResource RowDescription}" Text="" />
                </StackPanel>
                <ComboBox x:Name="ChatSize" Grid.Column="1" MinWidth="160" VerticalAlignment="Center" SelectionChanged="ChatLook_Changed" AutomationProperties.Name="Chat text size">
                    <ComboBoxItem Content="Small" Tag="small" /><ComboBoxItem Content="Medium" Tag="medium" /><ComboBoxItem Content="Large" Tag="large" />
                </ComboBox>
            </Grid>
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Hide lines after" Style="{StaticResource RowTitle}" />
                    <TextBlock  Style="{StaticResource RowDescription}" Text="" />
                </StackPanel>
                <ComboBox x:Name="ChatHide" Grid.Column="1" MinWidth="160" VerticalAlignment="Center" SelectionChanged="ChatLook_Changed" AutomationProperties.Name="Hide chat lines after">
                    <ComboBoxItem Content="Never" Tag="0" /><ComboBoxItem Content="30 seconds" Tag="30" /><ComboBoxItem Content="1 minute" Tag="60" /><ComboBoxItem Content="2 minutes" Tag="120" />
                </ComboBox>
            </Grid>
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Kick chatroom ID (optional)" Style="{StaticResource RowTitle}" />
                    <TextBlock  Style="{StaticResource RowDescription}" Text="Only needed if Kick blocks the channel lookup." />
                </StackPanel>
                <TextBox x:Name="KickRoom" Grid.Column="1" Width="200" VerticalAlignment="Center" PlaceholderText="e.g. 668" AutomationProperties.Name="Kick chatroom ID" />
            </Grid>

            <!-- Music -->
            <TextBlock Text="Music" Style="{StaticResource SectionHeaderStyle}" />
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Music on stream" Style="{StaticResource RowTitle}" />
                    <TextBlock Style="{StaticResource RowDescription}" Text="Which app's music is on stream. The other is muted on stream (when it has its own channel). [untitled] has no Windows app, so it means your browser." />
                    <TextBlock x:Name="MusicStatus" Style="{StaticResource RowDescription}" />
                </StackPanel>
                <ComboBox x:Name="MusicSource" Grid.Column="1" MinWidth="200" VerticalAlignment="Center" SelectionChanged="Music_Changed" AutomationProperties.Name="Music on stream">
                    <ComboBoxItem Content="Spotify" Tag="spotify" /><ComboBoxItem Content="[untitled] in a browser" Tag="untitled" />
                </ComboBox>
            </Grid>
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="FollowTitle" Text="Muze follows the music&apos;s key and tempo" Style="{StaticResource RowTitle}" />
                    <TextBlock Style="{StaticResource RowDescription}" TextWrapping="Wrap"
                               Text="Muze Auto Key listens to the music app&apos;s channel and sends its key to Muze (set Muze&apos;s Key Link to Follow); OmniCast tracks the beat and gives Muze the tempo." />
                    <TextBlock x:Name="FollowStatus" Style="{StaticResource RowDescription}" />
                </StackPanel>
                <ToggleSwitch x:Name="FollowOn" Grid.Column="1" Toggled="Follow_Toggled" AutomationProperties.Name="Muze follows the music" />
            </Grid>
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Now-playing card" Style="{StaticResource RowTitle}" />
                    <TextBlock Style="{StaticResource RowDescription}" Text="Shows for 30 seconds when a song starts. Move and resize it with Arrange on the Studio preview." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Preview card" Click="MusicPreview_Click" />
                    <ToggleSwitch x:Name="CardOn" Toggled="Music_Changed" AutomationProperties.Name="Show the now-playing card" />
                </StackPanel>
            </Grid>
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Card corner" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                <ComboBox x:Name="CardCorner" Grid.Column="1" MinWidth="200" VerticalAlignment="Center" SelectionChanged="Music_Changed" AutomationProperties.Name="Card corner">
                    <ComboBoxItem Content="Top left" Tag="topLeft" /><ComboBoxItem Content="Top right" Tag="topRight" />
                    <ComboBoxItem Content="Bottom left" Tag="bottomLeft" /><ComboBoxItem Content="Bottom right" Tag="bottomRight" />
                </ComboBox>
            </Grid>
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Card also on 9:16" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                <ToggleSwitch x:Name="CardVertical" Grid.Column="1" Toggled="Music_Changed" AutomationProperties.Name="Card also on 9:16" />
            </Grid>

            <!-- Discord call overlay -->
            <TextBlock Text="Discord call on stream" Style="{StaticResource SectionHeaderStyle}" />
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Set up once" Style="{StaticResource RowTitle}" />
                    <TextBlock  Style="{StaticResource RowDescription}" Text="Discord only shares who&apos;s in your call with an app you register yourself. It&apos;s free and takes a minute: 1. Open the Developer Portal and click New Application. 2. Under OAuth2, add the redirect http://localhost and save. 3. Copy the Client ID and Client Secret below. 4. Click Connect, then Authorize in the window Discord shows." TextWrapping="Wrap" />
                </StackPanel>
                <HyperlinkButton Grid.Column="1" Content="Open the Developer Portal" NavigateUri="https://discord.com/developers/applications" VerticalAlignment="Center" />
            </Grid>
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Client ID and Secret" Style="{StaticResource RowTitle}" />
                    <TextBlock x:Name="CallStatus" Style="{StaticResource RowDescription}" Text="Not connected" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                    <TextBox x:Name="CallClientId" Width="260" PlaceholderText="Client ID" AutomationProperties.Name="Discord Client ID" />
                    <PasswordBox x:Name="CallSecret" Width="260" PlaceholderText="Client Secret" AutomationProperties.Name="Discord Client Secret" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CallConnect" Content="Connect" Style="{StaticResource AccentButtonStyle}" Click="CallConnect_Click" />
                        <Button Content="Sign out" Click="CallSignOut_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Show the call&apos;s people" Style="{StaticResource RowTitle}" />
                    <TextBlock  Style="{StaticResource RowDescription}" Text="Their Discord pictures along the top of the 16:9 canvas, with a green ring while they talk. The secret and Discord&apos;s sign-in token are kept in Windows Credential Manager." TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Arrange in a row" Click="CallArrange_Click" />
                    <ToggleSwitch x:Name="CallVisible" Toggled="Call_Changed" AutomationProperties.Name="Show the call&apos;s people" />
                </StackPanel>
            </Grid>
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Dim people who aren&apos;t talking" Style="{StaticResource RowTitle}" />
                    <TextBlock  Style="{StaticResource RowDescription}" Text="" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch x:Name="CallDim" Grid.Column="1" Toggled="Call_Changed" AutomationProperties.Name="Dim people who aren&apos;t talking" />
            </Grid>
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Your PNGtuber" Style="{StaticResource RowTitle}" />
                    <TextBlock x:Name="MeStatus" Style="{StaticResource RowDescription}" Text="Pick idle and talking images. It talks when your mic does." TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Idle image…" Click="MeIdle_Click" />
                    <Button Content="Talking image…" Click="MeTalk_Click" />
                    <ToggleSwitch x:Name="MeOn" Toggled="Call_Changed" AutomationProperties.Name="Show your PNGtuber" />
                </StackPanel>
            </Grid>
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Mic sensitivity" Style="{StaticResource RowTitle}" />
                    <TextBlock  Style="{StaticResource RowDescription}" Text="How loud your mic has to be for your PNGtuber to talk." TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox x:Name="MeSensitivity" Grid.Column="1" MinWidth="160" VerticalAlignment="Center" SelectionChanged="Call_Changed" AutomationProperties.Name="Mic sensitivity">
                    <ComboBoxItem Content="High" Tag="-50" /><ComboBoxItem Content="Medium" Tag="-40" /><ComboBoxItem Content="Low" Tag="-30" />
                </ComboBox>
            </Grid>
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="When talking" Style="{StaticResource RowTitle}" />
                    <TextBlock Style="{StaticResource RowDescription}" TextWrapping="Wrap"
                               Text="For your PNGtuber and the call&apos;s people. Move and resize them with Arrange on the Studio preview." />
                </StackPanel>
                <ComboBox x:Name="TalkMotion" Grid.Column="1" MinWidth="160" VerticalAlignment="Center" SelectionChanged="Call_Changed" AutomationProperties.Name="When talking">
                    <ComboBoxItem Content="Just swap images" Tag="none" /><ComboBoxItem Content="Small hop" Tag="hop" />
                </ComboBox>
            </Grid>

            <!-- Accounts (stream info) -->
            <TextBlock Text="Accounts (stream titles and games)" Style="{StaticResource SectionHeaderStyle}" />
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Twitch" Style="{StaticResource RowTitle}" />
                    <TextBlock Style="{StaticResource RowDescription}" Text="1. dev.twitch.tv/console/apps › Register Your Application. 2. OAuth Redirect URL: http://localhost:39651. Category: Broadcaster Suite. Client Type: Public. 3. Copy the Client ID here, then Connect and enter the code Twitch shows." TextWrapping="Wrap" />
                    <HyperlinkButton Content="Open the Twitch developer console" NavigateUri="https://dev.twitch.tv/console/apps" Padding="0" />
                    <TextBlock x:Name="AccTwitchStatus" Style="{StaticResource RowDescription}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                    <TextBox x:Name="AccTwitchId" Width="260" PlaceholderText="Client ID" AutomationProperties.Name="Twitch Client ID" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AccTwitchConnect" Content="Connect" Style="{StaticResource AccentButtonStyle}" Tag="twitch" Click="AccountConnect_Click" />
                        <Button x:Name="AccTwitchSignOut" Content="Sign out" Tag="twitch" Click="AccountSignOut_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Kick" Style="{StaticResource RowTitle}" />
                    <TextBlock Style="{StaticResource RowDescription}" Text="1. kick.com › Settings › Developer › Create app. 2. Redirect URL: http://localhost:39651/callback. Scopes: read user, read channel, write channel. 3. Copy the Client ID and Client Secret here, then Connect and allow access." TextWrapping="Wrap" />
                    <HyperlinkButton Content="Open Kick&apos;s developer settings" NavigateUri="https://kick.com/settings/developer" Padding="0" />
                    <TextBlock x:Name="AccKickStatus" Style="{StaticResource RowDescription}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                    <TextBox x:Name="AccKickId" Width="260" PlaceholderText="Client ID" AutomationProperties.Name="Kick Client ID" />
                    <PasswordBox x:Name="AccKickSecret" Width="260" PlaceholderText="Client Secret" AutomationProperties.Name="Kick Client Secret" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AccKickConnect" Content="Connect" Style="{StaticResource AccentButtonStyle}" Tag="kick" Click="AccountConnect_Click" />
                        <Button x:Name="AccKickSignOut" Content="Sign out" Tag="kick" Click="AccountSignOut_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="YouTube" Style="{StaticResource RowTitle}" />
                    <TextBlock Style="{StaticResource RowDescription}" Text="1. console.cloud.google.com › new project › enable YouTube Data API v3. 2. OAuth consent screen: External, add your Google account as a test user. 3. Credentials › Create OAuth client ID › Desktop app. Copy the ID and secret here, then Connect. While the Google app is in testing, Google signs it out after 7 days; just Connect again. Secrets and sign-ins are kept in Windows Credential Manager." TextWrapping="Wrap" />
                    <HyperlinkButton Content="Open the Google Cloud console" NavigateUri="https://console.cloud.google.com/apis/library/youtube.googleapis.com" Padding="0" />
                    <TextBlock x:Name="AccYouTubeStatus" Style="{StaticResource RowDescription}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                    <TextBox x:Name="AccYouTubeId" Width="260" PlaceholderText="Client ID" AutomationProperties.Name="YouTube Client ID" />
                    <PasswordBox x:Name="AccYouTubeSecret" Width="260" PlaceholderText="Client Secret" AutomationProperties.Name="YouTube Client Secret" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AccYouTubeConnect" Content="Connect" Style="{StaticResource AccentButtonStyle}" Tag="youtube" Click="AccountConnect_Click" />
                        <Button x:Name="AccYouTubeSignOut" Content="Sign out" Tag="youtube" Click="AccountSignOut_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- App -->
            <TextBlock Text="App" Style="{StaticResource SectionHeaderStyle}" />
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Live preview" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="Turn off to save a little GPU. Previews already pause while the window is minimised or hidden." Style="{StaticResource RowDescription}" />
                </StackPanel>
                <ToggleSwitch x:Name="PreviewToggle" Grid.Column="1" Toggled="App_Changed" OnContent="On" OffContent="Off" MinWidth="0" />
            </Grid>
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Closing the window keeps OmniCast in the tray" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="So a stream or recording isn't cut by accident. Quit from the tray icon's menu." Style="{StaticResource RowDescription}" />
                </StackPanel>
                <ToggleSwitch x:Name="TrayToggle" Grid.Column="1" Toggled="App_Changed" OnContent="On" OffContent="Off" MinWidth="0" />
            </Grid>
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="Opens in the tray when you sign in." Style="{StaticResource RowDescription}" />
                </StackPanel>
                <ToggleSwitch x:Name="StartupToggle" Grid.Column="1" Toggled="App_Changed" OnContent="On" OffContent="Off" MinWidth="0" />
            </Grid>
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Keyboard shortcuts (work in any app)" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="Ctrl+Alt+L go live / end stream  ·  Ctrl+Alt+R start / stop recording  ·  Ctrl+Alt+M mute mic  ·  Ctrl+Alt+1 to 9 switch to scene 1 to 9" Style="{StaticResource RowDescription}" />
                    <TextBlock x:Name="HotkeyConflicts" Style="{StaticResource RowDescription}" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                </StackPanel>
            </Grid>

            <!-- About -->
            <TextBlock Text="About" Style="{StaticResource SectionHeaderStyle}" />
            <Grid Style="{StaticResource RowStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="VersionText" Style="{StaticResource RowTitle}" />
                    <TextBlock Style="{StaticResource RowDescription}"
                               Text="Free software under the GNU General Public License, version 2 or later. Built on libobs, the engine inside OBS Studio. OBS and OBS Studio are trademarks of the OBS Project; OmniCast isn't affiliated with it." />
                </StackPanel>
                <Button Grid.Column="1" Content="Open logs" VerticalAlignment="Center" Click="OpenLogs_Click" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
